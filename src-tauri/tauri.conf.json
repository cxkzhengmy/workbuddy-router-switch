{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkBuddy Router",
  "version": "1.0.7",
  "identifier": "com.wbrouter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "WorkBuddy Router",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 30
        },
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/agent-studio-runtime"]
  },
  "plugins": {
    "//updater": "故意禁用。原先指向官方仓库的上游发布页，但那是**未内嵌网关**的原版——用户点「检查更新」会装上一个网关功能消失的版本。pubkey 也是上游的，本项目自签的包同样装不上。方案 A 落地后 hub 已可独立更新，不再需要这个坏功能。重新启用需先 cargo tauri signer generate 生成自己的密钥对，并把 endpoints 换成本项目发布源。",
    "updater": {
      "active": false,
      "//": "pubkey 是 Tauri bundler 的**必填字段**（active=false 也会被解析），且必须是 base64 的 minisign 公钥文本，全 0 或纯 ASCII 都不行（报 invalid utf-8 / Base64 conversion failed，均实测）。这里是本项目自己生成的密钥对之公钥——真正的开关在 src-tauri/src/update_service.rs 的 UPDATER_ENABLED，后台与手动检查都在那里短路。",
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwNEU4RkQ5OEZCN0FGRApSV1Q5ZXZ1WS9lZ0VEd1VuVFpOYjU1OGJGd1NmMVhaWHJTSEdnNVRSSEcweUxWR05TN0h2WnloSwo="
    }
  }
}
