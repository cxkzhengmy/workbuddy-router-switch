{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkBuddy Router",
  "version": "1.0.11",
  "identifier": "com.wbrouter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "WorkBuddy Router",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 30
        },
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/agent-studio-runtime"],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "//updater": "本项目自有的更新通道：清单 latest.json 与安装包都发布在本仓库的 release 上。pubkey 必须是本机 $HOME/.wb-switch/wb-switch-updater.key 对应的公钥（base64 的 minisign 公钥文本），否则 bundler 会警告签名与公钥不匹配，下载回来的包也验签失败。真正的开关在 src-tauri/src/update_service.rs 的 UPDATER_ENABLED，两边要一起开。",
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/cxkzhengmy/workbuddy-router-switch/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzNzgwN0JBMDM5QzUxMjUKUldRbFVad0R1Z2Q0UTlnSnZLTldUZGxPTllCZFA1NUVWUngrTHRJVzdkMnNadHY3Y3hXYXV5K2wK"
    }
  }
}
