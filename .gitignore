vendor/agent-companion/dist-embed.old-*/

# 构建时由 scripts/build-exe-local.sh 生成（置空 beforeBuildCommand 防递归）
/src-tauri/tauri.windows.conf.json

# 本机 Cargo 链接器配置：内容是绝对路径（指向本机 rustup 的 lld-link.exe），
# 提交上去会让别人 clone 后直接构建失败。由 build-exe-local.sh 按当前机器
# 自动生成；有 MSVC 构建工具的人不需要它，留空即走默认 link.exe。
# 需要手动配置时参考 .cargo/config.toml.example。
/.cargo/config.toml
